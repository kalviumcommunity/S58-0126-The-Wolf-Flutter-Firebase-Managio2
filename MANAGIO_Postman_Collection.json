              "raw": "{\n  \"fields\": {\n    \"userId\": {\"stringValue\": \"YOUR_USER_ID_HERE\"},\n    \"name\": {\"stringValue\": \"Acme Corporation\"},\n    \"email\": {\"stringValue\": \"contact@acme.com\"},\n    \"phone\": {\"stringValue\": \"+1234567890\"},\n    \"company\": {\"stringValue\": \"Acme Corp\"},\n    \"createdAt\": {\"timestampValue\": \"2025-01-30T00:00:00Z\"}\n  }\n}"
